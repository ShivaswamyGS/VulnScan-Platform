# --- App ---
APP_NAME=VulnTriage Platform
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Security ---
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
POSTGRES_USER=vulntriage_user
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=vulntriage
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://vulntriage_user:change-this-password@localhost:5432/vulntriage

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173"]

# --- ML Model Artifacts ---
ML_MODEL_PATH=../ai/artifacts/model.pkl
ML_VECTORIZER_PATH=../ai/artifacts/tfidf.pkl

# --- Uploads ---
UPLOAD_DIR=../uploads
MAX_UPLOAD_MB=10
